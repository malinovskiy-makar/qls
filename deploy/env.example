# ОБРАЗЕЦ переменных окружения боевого сервера.
#
# Настоящий файл лежит ТОЛЬКО на сервере: /srv/weconomics/.env
# Права 600, владелец makar. В репозиторий не попадает никогда.
#
# Имя этого образца — без точки в начале (env.example, не .env.example),
# потому что .gitignore закрывает шаблон .env.* целиком, а образец
# обязан попасть в репозиторий.
#
# Как развернуть на новом сервере:
#   cp deploy/env.example /srv/weconomics/.env
#   chmod 600 /srv/weconomics/.env
#   # затем вписать значения, сгенерировав каждое:
#   tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32
#
# Только латиница и цифры: значения попадут в строку подключения к базе,
# где символы вроде : / @ ? # ломают разбор URL.

# --- PostgreSQL 17 ---
# Имя базы и пользователя postgres читает ТОЛЬКО при первой инициализации
# тома. Поменять их позже = пересоздавать том вместе с данными.
POSTGRES_DB=weconomics
POSTGRES_USER=weconomics
POSTGRES_PASSWORD=

# --- Redis 7 ---
# Пароль обязателен: без него Redis пускает любого, кто попал во внутреннюю
# сеть Docker.
REDIS_PASSWORD=

# Адрес Redis для Django. Заполнить ТЕМ ЖЕ паролем, что в REDIS_PASSWORD:
#     REDIS_URL=redis://:ТОТ_ЖЕ_ПАРОЛЬ@redis:6379
# Имя хоста — redis: это имя службы во внутренней сети Docker, наружу
# порт не опубликован.
#
# ⚠️ БЕЗ ЭТОЙ ПЕРЕМЕННОЙ БОЕВЫЕ НАСТРОЙКИ НЕ ПОДНИМУТСЯ ВОВСЕ, и это
# сделано намеренно. Без неё Django молча взял бы кэш в памяти процесса,
# сайт бы поднялся, и на девяти воркерах получилось бы девять независимых
# кэшей: попадание примерно один раз из девяти, счётчик неудачных входов
# у каждого воркера свой. Тихая деградация ищется неделями, падение при
# старте — минуты.
#
# ⚠️ НОМЕР БАЗЫ ЗДЕСЬ НЕ УКАЗЫВАТЬ. Его дописывают настройки: кэш живёт
# в базе 0, сессии — в базе 1. Они разные потому, что cache.clear() у Redis
# это FLUSHDB: лежи сессии рядом с кэшем, любой сброс кэша разлогинил бы
# всех. Раскладка баз — в config/settings.py у словаря CACHES.
#
# ⚠️ ЭТОТ ЖЕ REDIS_URL НУЖЕН И НОВОМУ СЕРВИСУ `ws` (WebSocket дуэли,
# сессия «Wecon Rush»). Отдельной переменной под него заводить не нужно:
# `ws` и `web` читают из ОДНОГО И ТОГО ЖЕ `.env` (deploy/docker-compose.yml,
# оба сервиса подключают `env_file: /srv/weconomics/.env`), а базу 3 для
# табло дуэли настройки дописывают сами (config/settings.py::CHANNEL_LAYERS)
# — так же, как базу 0 для кэша и базу 1 для сессий чуть выше.
#
# ⚠️ Если пароль сгенерирован не по инструкции выше и содержит @ : / # или ?,
# его надо percent-encode, иначе адрес не разберётся и старт упадёт.
REDIS_URL=

# Адрес PostgreSQL для Django. Собрать из трёх переменных выше:
#     DATABASE_URL=postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@postgres:5432/БАЗА
# Имя хоста — postgres: это имя службы во внутренней сети Docker.
#
# ⚠️ ЭТО ЕДИНСТВЕННОЕ МЕСТО, ГДЕ ЖИВЁТ СТРОКА ПОДКЛЮЧЕНИЯ. Раньше она
# собиралась ещё и в docker-compose.yml из POSTGRES_*; оттуда убрана.
# Два места для одной строки — это способ поменять пароль в одном из них
# и полдня искать, почему не помогло. Меняете POSTGRES_PASSWORD —
# правьте и эту строку.
#
# ⚠️ Если пароль содержит @ : / # или ?, его надо percent-encode
# (%40, %3A, %2F, %23, %3F), иначе адрес разберётся не туда.
DATABASE_URL=

# --- Django ---
# Какие настройки грузить. На сервере всегда боевые.
DJANGO_SETTINGS_MODULE=config.settings_production

# Ключ подписи. Генерировать НА СЕРВЕРЕ и никуда не копировать:
#   docker compose run --rm web python -c \
#     "from django.core.management.utils import get_random_secret_key as k; print(k())"
# ⚠️ Смена ключа разлогинивает всех и ломает ссылки восстановления пароля.
SECRET_KEY=

# Домены через запятую, БЕЗ схемы. Звёздочка запрещена: она отключает
# проверку заголовка Host, на которой держатся ссылки в письмах.
# Пример: weconomics.site,www.weconomics.site
ALLOWED_HOSTS=

# То же самое, но СО СХЕМОЙ https:// — так требует Django.
# Пример: https://weconomics.site,https://www.weconomics.site
CSRF_TRUSTED_ORIGINS=

# ⚠️ СМЫСЛОВОЙ ПОИСК НА СЕРВЕРЕ ВЫКЛЮЧЕН, И ЭТО НЕ ВРЕМЕННАЯ НЕБРЕЖНОСТЬ.
# Модель эмбеддингов весит 2,12 ГБ и грузится в память КАЖДОГО воркера:
# четыре воркера на сервере с 8 ГБ — это 8,5 ГБ, то есть первый же запрос
# к умному поиску убил бы сайт («мина №1»). Поиск при выключенном флаге не
# пропадает: страница отдаёт результаты по словам и честно говорит об этом.
# Включать — только после выноса модели в отдельный процесс.
SEMANTIC_SEARCH_ENABLED=0

# Прогрев умного поиска: корпус bm25 (и индекс векторов, если смысловой поиск
# включён) строится в фоновом потоке сразу после старта воркера gunicorn, а
# не на первом поиске человека (catalog/warmup.py). 0 — выключить.
SMART_SEARCH_WARMUP=1

# --- Чат на странице задачи ---
# Поставщик и модели чата (решение владельца 15.09.2026). Ключ — GLM_API_KEY,
# тот же, что у умной сортировки поиска; без ключа карточки «Спросить ИИ» на
# странице задачи нет вовсе, остальное работает.
# GLM-5.3 картинок не принимает: фото и PDF решения сначала переписывает в
# текст модель зрения, разговор ведёт текстовая. Пустое значение модели
# зрения — модель чата видит сама.
CATALOG_CHAT_PROVIDER=glm
CATALOG_CHAT_MODEL=glm-5.3
CATALOG_CHAT_VISION_MODEL=glm-5.3-flash
# Суточный денежный потолок чата, $ — оба шага, зрение и разговор. Упёрлись —
# помощник вежливо отказывает до завтра, страница не ломается.
CATALOG_CHAT_DAILY_CAP_USD=1.0

# --- Яндекс Метрика (ADR 0133) ---
# Номер счётчика, ТОЛЬКО цифры. Пусто — на страницах нет ни счётчика, ни чужих
# адресов в CSP. Задаётся ТОЛЬКО на бою: площадка dev.weconomics.ai живёт на тех
# же боевых настройках, и номер в её .env смешал бы просмотры команды с людьми.
# После правки — `docker compose up -d --force-recreate web`: переменные
# окружения читаются при старте контейнера, простой restart их не подхватит.
YANDEX_METRIKA_ID=

# Реквизиты правовых документов (/legal/*, Правовой контур, часть А). ОБЯЗАТЕЛЬНЫ:
# при пустых значениях `manage.py check` (его запускает и `migrate` в entrypoint)
# падает с ошибкой legal.E001, контейнер web не поднимается — сайт не выкатится
# с заглушкой «[не заполнено]» вместо почты и даты.
#   LEGAL_CONTACT_EMAIL — почта для обращений по данным (ящик у российского провайдера);
#   LEGAL_DOCS_DATE     — дата редакции документов строкой, например «15 октября 2026 г.»;
#   LEGAL_TG_RELAY      — хостер и страна сервера-посредника Telegram, на бою
#                         «VDSina (SERVERS TECH FZCO, ОАЭ), Нидерланды» (deploy/tg_relay/README.md);
#                         без него падает legal.E003.
# После правки — `docker compose up -d --force-recreate web`.
LEGAL_CONTACT_EMAIL=
LEGAL_DOCS_DATE=
LEGAL_TG_RELAY=

# ─── Почта (docs/MAIL.md) ───
# MAIL_ENABLED=1 включает регистрацию с почтой, вход почтой и сброс пароля кодом.
# Включать ТОЛЬКО после успешного send_test_email на этом сервере.
MAIL_ENABLED=0
EMAIL_HOST=postbox.cloud.yandex.net
EMAIL_PORT=587
# Идентификатор и секрет API-ключа сервисного аккаунта Postbox (секрет не коммитить)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Weconomics <noreply@weconomics.ai>
# Пусто — «Ответить» ведёт на LEGAL_CONTACT_EMAIL
MAIL_REPLY_TO=

# ─── Стена тренажёра ВП и бот Telegram (docs/VP.md, «Стена 2 тура») ───
# Стена включена по умолчанию; тренажёр 2 тура без обоих путей (бот и почта) не
# выкатываем. Проверка: manage.py vp_wall_status — оба пути «да».
VP_WALL_ENABLED=1
# Путь Telegram на стене: 0 — только почта (если Telegram лёг во время тура).
VP_WALL_TG_ENABLED=1
# Токен бота из BotFather (секрет, не коммитить, не пересылать в чат).
TELEGRAM_BOT_TOKEN=
# Имя бота без «@»
TELEGRAM_BOT_USERNAME=
# Секрет вебхука, только A-Za-z0-9_-; пусто — вебхук закрыт для всех. Сгенерировать:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Канал, подписку на который проверяет бот. Пусто — @weconomics_ru.
TELEGRAM_CHANNEL=
# Только https://. Пусто — https://api.telegram.org. ⚠️ НА БОЮ: https://api.telegram.org:18443
# (без слэша): с российского сервера api.telegram.org недоступен (28.10.2026), поэтому на хосте
# слушает обратный SSH-туннель до нашего посредника (сквозной TLS), а в docker-compose у web и
# tgbot имя api.telegram.org указывает на шлюз хоста (extra_hosts). Инструкция — deploy/tg_relay/README.md. Сообщения бот получает службой tgbot (длинный опрос),
# секрет вебхука при этом всё равно нужен: без него путь Telegram считается ненастроенным.
TELEGRAM_API_BASE=

# ─── Вход для VPN на машине tg-relay (deploy/web_relay/README.md) ───
# Публичный IPv4 машины tg-relay: она пересылает 443/80 на наши 8443/8080 с PROXY protocol.
# Django эту строку не читает. Её читают два скрипта на хосте:
#   deploy/web_relay/prod_realip.sh   — пишет nginx-у, чьему PROXY-заголовку верить
#                                       (conf.d/web_relay_realip.conf);
#   deploy/web_relay/prod_firewall.sh — пускает к 8080/8443 только этот адрес (DOCKER-USER).
# Только адрес, без маски и без порта. Пусто — входа нет: 8080/8443 закрыты всем, заголовку
# не верит никто. После правки — запустить оба скрипта (README).
WEB_RELAY_IP=

# ─── Вход через VK ID и Яндекс ID, онбординг (docs/SOCIAL_KEYS.md, docs/SECURITY.md) ───
# Кнопка сервиса появляется, только если SOCIAL_LOGIN_ENABLED=1 И заданы ключи этого
# сервиса. Ключи — секреты: в репозиторий и в чат не попадают, живут только в .env на боевом
# сервере. Пока пусто — входа через сервисы нет, остальное работает.
# После правки — `docker compose up -d --force-recreate web`: переменные читаются
# при старте контейнера.
# АВАРИЙНОЕ ВЫКЛЮЧЕНИЕ: SOCIAL_LOGIN_ENABLED=0 и ONBOARDING_ENABLED=0, затем пересоздать web.
SOCIAL_LOGIN_ENABLED=
# VK ID: идентификатор приложения (и секрет, если кабинет его выдал)
VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=
# Яндекс ID: идентификатор и пароль приложения
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Откуда строится адрес возврата. ⚠️ На бою ровно этот: сайт отвечает на .site и .ai, а в
# кабинетах сервисов прописан один адрес — с .site сервис откажет «redirect_uri не совпадает».
SOCIAL_REDIRECT_BASE=https://weconomics.ai
# Дата рождения от сервиса пишется в профиль, только когда она внесена в документы
# (ред. 3). Пусто = 0 — не сохраняем.
SOCIAL_STORE_BIRTHDATE=
# Сколько секунд ждать сервис входа на один запрос
SOCIAL_HTTP_TIMEOUT=20
# Обязательная анкета при первом входе; по умолчанию 1. 0 — аварийно выключить.
# ⚠️ Здесь НЕ пусто, а 1: пустая строка в .env — это «задана и не равна 1», то есть
# выключено (config/settings.py читает значение как есть).
ONBOARDING_ENABLED=1

# Сколько рабочих процессов gunicorn. По умолчанию 4 — обоснование в
# docs/SERVER.md. Не поднимать до девяти «по формуле 2N+1»: память нужна
# под сервис поиска, PostgreSQL и Redis.
GUNICORN_WORKERS=4

# Класс воркеров и потоки в каждом (ADR 0140, docs/SERVER.md «Воркеры и
# потоки»). gthread × 8: вопрос к ИИ ждёт поставщика в своём потоке и не
# занимает сайт; мест 4 × 8 = 32. Строки можно не писать — это значения по
# умолчанию из deploy/entrypoint.sh.
# ОТКАТ на прежнее поведение (одно место на воркер): GUNICORN_WORKER_CLASS=sync,
# затем `docker compose up -d web` и `docker compose restart nginx`.
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=8

# --- Резервное копирование ---
# ⚠️ ПУСТЫЕ ЗНАЧЕНИЯ = КОПИИ ЛЕЖАТ ТОЛЬКО НА ЭТОМ ЖЕ СЕРВЕРЕ.
# Правило проекта: бэкап живёт не у того же провайдера, что и сервер.
# Пока эти строки пусты, правило не выполнено — карточка в Notion заведена.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
