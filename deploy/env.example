# ОБРАЗЕЦ переменных окружения боевого сервера.
#
# Настоящий файл лежит ТОЛЬКО на сервере: /srv/weconomics/.env
# Права 600, владелец makar. В репозиторий не попадает никогда.
#
# Имя этого образца — без точки в начале (env.example, не .env.example),
# потому что .gitignore закрывает шаблон .env.* целиком, а образец
# обязан попасть в репозиторий.
#
# Как развернуть на новом сервере:
#   cp deploy/env.example /srv/weconomics/.env
#   chmod 600 /srv/weconomics/.env
#   # затем вписать значения, сгенерировав каждое:
#   tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32
#
# Только латиница и цифры: значения попадут в строку подключения к базе,
# где символы вроде : / @ ? # ломают разбор URL.

# --- PostgreSQL 17 ---
# Имя базы и пользователя postgres читает ТОЛЬКО при первой инициализации
# тома. Поменять их позже = пересоздавать том вместе с данными.
POSTGRES_DB=weconomics
POSTGRES_USER=weconomics
POSTGRES_PASSWORD=

# --- Redis 7 ---
# Пароль обязателен: без него Redis пускает любого, кто попал во внутреннюю
# сеть Docker.
REDIS_PASSWORD=

# Адрес Redis для Django. Заполнить ТЕМ ЖЕ паролем, что в REDIS_PASSWORD:
#     REDIS_URL=redis://:ТОТ_ЖЕ_ПАРОЛЬ@redis:6379
# Имя хоста — redis: это имя службы во внутренней сети Docker, наружу
# порт не опубликован.
#
# ⚠️ БЕЗ ЭТОЙ ПЕРЕМЕННОЙ БОЕВЫЕ НАСТРОЙКИ НЕ ПОДНИМУТСЯ ВОВСЕ, и это
# сделано намеренно. Без неё Django молча взял бы кэш в памяти процесса,
# сайт бы поднялся, и на девяти воркерах получилось бы девять независимых
# кэшей: попадание примерно один раз из девяти, счётчик неудачных входов
# у каждого воркера свой. Тихая деградация ищется неделями, падение при
# старте — минуты.
#
# ⚠️ НОМЕР БАЗЫ ЗДЕСЬ НЕ УКАЗЫВАТЬ. Его дописывают настройки: кэш живёт
# в базе 0, сессии — в базе 1. Они разные потому, что cache.clear() у Redis
# это FLUSHDB: лежи сессии рядом с кэшем, любой сброс кэша разлогинил бы
# всех. Раскладка баз — в config/settings.py у словаря CACHES.
#
# ⚠️ Если пароль сгенерирован не по инструкции выше и содержит @ : / # или ?,
# его надо percent-encode, иначе адрес не разберётся и старт упадёт.
REDIS_URL=

# Адрес PostgreSQL для Django. Собрать из трёх переменных выше:
#     DATABASE_URL=postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@postgres:5432/БАЗА
# Имя хоста — postgres: это имя службы во внутренней сети Docker.
#
# ⚠️ ЭТО ЕДИНСТВЕННОЕ МЕСТО, ГДЕ ЖИВЁТ СТРОКА ПОДКЛЮЧЕНИЯ. Раньше она
# собиралась ещё и в docker-compose.yml из POSTGRES_*; оттуда убрана.
# Два места для одной строки — это способ поменять пароль в одном из них
# и полдня искать, почему не помогло. Меняете POSTGRES_PASSWORD —
# правьте и эту строку.
#
# ⚠️ Если пароль содержит @ : / # или ?, его надо percent-encode
# (%40, %3A, %2F, %23, %3F), иначе адрес разберётся не туда.
DATABASE_URL=

# --- Django ---
# Какие настройки грузить. На сервере всегда боевые.
DJANGO_SETTINGS_MODULE=config.settings_production

# Ключ подписи. Генерировать НА СЕРВЕРЕ и никуда не копировать:
#   docker compose run --rm web python -c \
#     "from django.core.management.utils import get_random_secret_key as k; print(k())"
# ⚠️ Смена ключа разлогинивает всех и ломает ссылки восстановления пароля.
SECRET_KEY=

# Домены через запятую, БЕЗ схемы. Звёздочка запрещена: она отключает
# проверку заголовка Host, на которой держатся ссылки в письмах.
# Пример: weconomics.site,www.weconomics.site
ALLOWED_HOSTS=

# То же самое, но СО СХЕМОЙ https:// — так требует Django.
# Пример: https://weconomics.site,https://www.weconomics.site
CSRF_TRUSTED_ORIGINS=

# ⚠️ СМЫСЛОВОЙ ПОИСК НА СЕРВЕРЕ ВЫКЛЮЧЕН, И ЭТО НЕ ВРЕМЕННАЯ НЕБРЕЖНОСТЬ.
# Модель эмбеддингов весит 2,12 ГБ и грузится в память КАЖДОГО воркера:
# четыре воркера на сервере с 8 ГБ — это 8,5 ГБ, то есть первый же запрос
# к умному поиску убил бы сайт («мина №1»). Поиск при выключенном флаге не
# пропадает: страница отдаёт результаты по словам и честно говорит об этом.
# Включать — только после выноса модели в отдельный процесс.
SEMANTIC_SEARCH_ENABLED=0

# Сколько рабочих процессов gunicorn. По умолчанию 4 — обоснование в
# docs/SERVER.md. Не поднимать до девяти «по формуле 2N+1»: память нужна
# под сервис поиска, PostgreSQL и Redis.
GUNICORN_WORKERS=4

# --- Резервное копирование ---
# ⚠️ ПУСТЫЕ ЗНАЧЕНИЯ = КОПИИ ЛЕЖАТ ТОЛЬКО НА ЭТОМ ЖЕ СЕРВЕРЕ.
# Правило проекта: бэкап живёт не у того же провайдера, что и сервер.
# Пока эти строки пусты, правило не выполнено — карточка в Notion заведена.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
