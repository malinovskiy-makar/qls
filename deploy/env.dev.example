# ОБРАЗЕЦ переменных окружения ПЛОЩАДКИ dev.weconomics.ai.
#
# ⚠️ ЭТО НЕ БОЕВОЙ ФАЙЛ. Боевой образец — `deploy/env.example`, настоящий
# боевой файл — `/srv/weconomics/.env`. Этот разворачивается в
# `/srv/weconomics/dev/.env` и читается ТОЛЬКО службами площадки
# (deploy/docker-compose.dev-site.yml). Перепутать их — значит подключить
# площадку к боевой базе, а там её ждёт `dev_scrub`, стирающий всех людей.
#
# Как развернуть:
#   cp deploy/env.dev.example /srv/weconomics/dev/.env
#   chmod 600 /srv/weconomics/dev/.env
#   nano /srv/weconomics/dev/.env        # вписать значения
#   grep -c '^[A-Z_]*=$' /srv/weconomics/dev/.env    # 0 — пустых не осталось
#
# Генерация значений (по одной строке на каждое):
#   tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo
#
# Только латиница и цифры, без пробелов и кавычек: файл читают и оболочка,
# и разбор URL. Значение вида a(b)c для оболочки — уже синтаксис.

# --- PostgreSQL: КОНТЕЙНЕР ОБЩИЙ С БОЕМ, БАЗА СВОЯ ---------------------------
# ⚠️ Эти три значения КОПИРУЮТСЯ ИЗ БОЕВОГО /srv/weconomics/.env как есть.
# Отдельного контейнера PostgreSQL у площадки нет (лишний гигабайт на сервере
# с 8 ГБ), она живёт в ТОМ ЖЕ контейнере, но в ДРУГОЙ базе `weconomics_dev`.
# Пользователь и пароль поэтому те же самые — новых заводить не нужно.
# Прочитать боевые значения:
#   sudo sed -n 's/^POSTGRES_USER=//p;s/^POSTGRES_PASSWORD=//p' /srv/weconomics/.env
POSTGRES_DB=weconomics
POSTGRES_USER=weconomics
POSTGRES_PASSWORD=

# ⚠️ ИМЯ БАЗЫ ЗДЕСЬ — weconomics_dev, И ЭТО САМАЯ ВАЖНАЯ СТРОКА ФАЙЛА.
# Ошибка в ней означает, что площадка работает на БОЕВОЙ базе: миграции с
# main поедут в боевую схему, а `deploy/dev_refresh.sh` сотрёт живых людей.
# Хост `postgres` — имя боевого контейнера в общей сети Docker.
#     DATABASE_URL=postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@postgres:5432/weconomics_dev
DATABASE_URL=

# --- Redis: У ПЛОЩАДКИ СВОЙ КОНТЕЙНЕР ----------------------------------------
# ⚠️ ПАРОЛЬ ЗДЕСЬ СВОЙ, НЕ БОЕВОЙ. Redis у площадки отдельный (`redis-dev`),
# потому что номера баз зашиты в настройки: 0 — кэш, 1 — сессии, 3 — табло
# дуэлей. На общем Redis сессии площадки и боя лежали бы в одной базе, а
# `cache.clear()` — это FLUSHDB: один сброс кэша на площадке разлогинил бы
# живых людей на бою.
REDIS_PASSWORD=

# Адрес Redis для Django. Хост — `redis-dev` (имя службы площадки), НЕ `redis`.
# Пароль — тот же, что в REDIS_PASSWORD выше.
#     REDIS_URL=redis://:ТОТ_ЖЕ_ПАРОЛЬ@redis-dev:6379
# ⚠️ Номер базы НЕ указывать: его дописывают настройки.
REDIS_URL=

# --- Django ------------------------------------------------------------------
# ⚠️ НАСТРОЙКИ БОЕВЫЕ, И В ЭТОМ ВЕСЬ СМЫСЛ ПЛОЩАДКИ. 06.09.2026 два бага
# всплыли только на бою (site_meta не подключён в settings_production;
# varchar(300) на PostgreSQL) именно потому, что до боя код нигде не жил в
# боевых условиях. Площадка их ловит до того, как их увидят ученики.
DJANGO_SETTINGS_MODULE=config.settings_production

# Ключ подписи. СВОЙ, не боевой: общий ключ означал бы, что кука сессии,
# выданная площадкой, принимается боем.
# Сгенерировать:
#   docker run --rm python:3.13-slim python -c \
#     "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(50)))"
SECRET_KEY=

# Домены площадки, БЕЗ схемы. Только один: боевые имена сюда не вписывать.
ALLOWED_HOSTS=dev.weconomics.ai

# То же со схемой https:// — так требует Django.
CSRF_TRUSTED_ORIGINS=https://dev.weconomics.ai

# --- Что отличает площадку от боя --------------------------------------------
# ⚠️ ТОЛЬКО ЭТА ПЕРЕМЕННАЯ ОТЛИЧАЕТ ПЛОЩАДКУ ОТ БОЯ ДЛЯ САМОГО ПРИЛОЖЕНИЯ.
# Она делает две вещи: рисует в шапке полосу «dev · <хеш> · рабочая версия,
# не бой» (иначе площадку не отличить от боя, кроме адреса в строке браузера)
# и РАЗРЕШАЕТ работу команде `dev_scrub`. На бою значение по умолчанию `prod`,
# и `dev_scrub` там отказывается запускаться — это её предохранитель.
SITE_ENV=dev

# Пароль ЧЕТЫРЁХ тестовых аккаунтов площадки: `dev-student`, `dev-teacher`,
# `dev-parent`, `dev-admin`. Пароль у всех один — отличаются логин и роль.
# Их заводит `manage.py dev_scrub` после восстановления дампа; с пустым
# значением команда отказывается работать, а не создаёт аккаунты без пароля.
# ⚠️ Не совпадать с паролем basic auth в nginx: это два разных рубежа.
DEV_ACCOUNTS_PASSWORD=

# Номер счётчика Яндекс Метрики НА ПЛОЩАДКЕ ПУСТОЙ, и это не забыто (ADR 0133):
# иначе просмотры и регистрации команды попали бы в статистику боя. Счётчика
# на площадке нет вовсе, CSP остаётся без чужих адресов.
YANDEX_METRIKA_ID=

# Реквизиты правовых документов нужны и площадке: она живёт на боевых настройках,
# а проверки legal.E001 и legal.E003 не пускают их с пустой почтой, датой и хостером посредника. Подойдут любые
# значения, это не боевые данные.
LEGAL_CONTACT_EMAIL=
LEGAL_DOCS_DATE=
LEGAL_TG_RELAY=

# ─── Почта (docs/MAIL.md) ───
# MAIL_ENABLED=1 включает регистрацию с почтой, вход почтой и сброс пароля кодом.
# Включать ТОЛЬКО после успешного send_test_email на этом сервере.
MAIL_ENABLED=0
EMAIL_HOST=postbox.cloud.yandex.net
EMAIL_PORT=587
# Идентификатор и секрет API-ключа сервисного аккаунта Postbox (секрет не коммитить)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Weconomics <noreply@weconomics.ai>
# Пусто — «Ответить» ведёт на LEGAL_CONTACT_EMAIL
MAIL_REPLY_TO=

# ─── Стена тренажёра ВП и бот Telegram (docs/VP.md, «Стена 2 тура») ───
# Стена включена по умолчанию; тренажёр 2 тура без обоих путей (бот и почта) не
# выкатываем. Проверка: manage.py vp_wall_status — оба пути «да».
VP_WALL_ENABLED=1
# Путь Telegram на стене: 0 — только почта (если Telegram лёг во время тура).
VP_WALL_TG_ENABLED=1
# ⚠️ На маке и на площадке — ОТДЕЛЬНЫЙ бот разработки, не боевой: `tg_poll --force`
# снимает вебхук, и у боевого бота это сломало бы стену на сайте.
# Токен бота из BotFather (секрет, не коммитить, не пересылать в чат).
TELEGRAM_BOT_TOKEN=
# Имя бота без «@»
TELEGRAM_BOT_USERNAME=
# Секрет вебхука, только A-Za-z0-9_-; пусто — вебхук закрыт для всех. Сгенерировать:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
# Канал, подписку на который проверяет бот. Пусто — @weconomics_ru.
TELEGRAM_CHANNEL=
# Только https://. Пусто — https://api.telegram.org. Свой посредник — только НАШ сервер:
# через него проходит токен.
TELEGRAM_API_BASE=

# --- Как на бою --------------------------------------------------------------
# Смысловой поиск выключен ровно так же, как на бою (ADR 0012): модель весит
# 2,12 ГБ. Площадка ходит в ОБЩИЙ с боем контейнер `search` — второй экземпляр
# запрещён, ему просто нет места в 8 ГБ сервера.
SEMANTIC_SEARCH_ENABLED=0
SEARCH_SERVICE_URL=http://search:8001

# ⚠️ ДВА ВОРКЕРА, А НЕ ЧЕТЫРЕ. У боя четыре, и это обосновано в docs/SERVER.md
# замером памяти. Площадка живёт на ТОМ ЖЕ сервере рядом с боем: её воркеры
# отнимают память у настоящих посетителей. Двоих хватает — площадку смотрят
# один-три человека, а не поток.
GUNICORN_WORKERS=2

# --- Резервного копирования у площадки НЕТ -----------------------------------
# ⚠️ ПЕРЕМЕННЫХ BACKUP_S3_* ЗДЕСЬ НЕТ НАМЕРЕННО, а не забыты при копировании
# боевого образца. Базу площадки бэкапить незачем: она пересоздаётся из
# боевого дампа одной командой `deploy/dev_refresh.sh`, и своих данных,
# которые нельзя потерять, на ней нет по определению. Боевой таймер бэкапа
# снимает копию боевой базы и площадку не трогает.
#
# Практическое следствие: в этом файле не должно остаться НИ ОДНОГО пустого
# значения — проверка `grep -c '^[A-Z_]*=$' /srv/weconomics/dev/.env` обязана
# вернуть 0. Пустая строка здесь означает незаполненный секрет.
