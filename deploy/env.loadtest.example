# Образец окружения стенда нагрузки (deploy/docker-compose.loadtest.yml).
# Скопировать в deploy/env.loadtest (он в .gitignore) и вписать SECRET_KEY.
# Секретов боя здесь нет: база и Redis — локальные dev-контейнеры.

# Настройки боевые — тот же модуль, что на сервере. DEBUG выключен.
DJANGO_SETTINGS_MODULE=config.settings_production
SECRET_KEY=
ALLOWED_HOSTS=weconomics.ai,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://weconomics.ai

# База стенда — копия копии боя, сама копия боя не меняется:
#   docker exec qls_postgres_dev psql -U qls -d postgres -c "CREATE DATABASE weco_loadtest TEMPLATE weco_beta_20261007"
DATABASE_URL=postgres://qls:qls_dev_password@host.docker.internal:55432/weco_loadtest
REDIS_URL=redis://host.docker.internal:56379

# Медленный подставной ИИ вместо настоящего: бесплатно, держит воркер 20 с.
CATALOG_CHAT_PROVIDER=fake
AI_PROVIDER=fake
AI_FAKE_DELAY_SECONDS=20
QLS_FAKE_REPLY={"reply": "проба стенда"}

# Лимиты подняты, чтобы не мешали замеру: служебный аккаунт шлёт десятки вопросов.
AI_GENERATOR_DAILY_LIMIT=100000
CATALOG_CHAT_DAILY_CAP_USD=100000

# Сервиса поиска на стенде нет; прогрев корпуса не нужен замеру.
SMART_SEARCH_WARMUP=0
SEMANTIC_SEARCH_ENABLED=0

# Воркеры — как на бою. Класс и потоки (после правки entrypoint):
# по умолчанию gthread × 8; sync — чтобы перемерить «как было».
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=8
