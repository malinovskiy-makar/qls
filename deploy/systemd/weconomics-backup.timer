[Unit]
Description=Ежедневная резервная копия базы weconomics

[Timer]
# 03:20 по московскому времени — после ночных задач и до утреннего трафика.
OnCalendar=*-*-* 03:20:00
# ⚠️ Persistent нужен потому, что сервер могут перезагрузить в 03:00.
# Без него пропущенный запуск просто теряется, и в цепочке копий появляется
# дыра, которую замечают через месяц.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
