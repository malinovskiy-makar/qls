[Unit]
Description=Еженедельная синхронизация справочника школ weconomics с реестром Рособрнадзора

[Timer]
# Понедельник 05:30 по московскому времени: после воскресной чистки (04:10) и ночной
# резервной копии (03:20), до утреннего трафика. Реестр обновляется ежедневно, школам
# хватает раза в неделю (решение владельца 29.10.2026).
OnCalendar=Mon *-*-* 05:30:00
# ⚠️ Persistent: перезагрузка сервера ночью не должна съедать неделю.
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
