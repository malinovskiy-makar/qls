[Unit]
Description=Еженедельная чистка данных старше срока хранения weconomics

[Timer]
# Воскресенье 04:10 по московскому времени: после ночной резервной копии (03:20),
# до утреннего трафика. Резервная копия снимается ДО чистки: удалённое живёт в копиях
# до 30 дней (Политика, раздел 7).
OnCalendar=Sun *-*-* 04:10:00
# ⚠️ Persistent: перезагрузка сервера в воскресенье ночью не должна съедать неделю.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
