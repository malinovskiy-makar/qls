# Инструменты разработки и проверок. В образ не попадают.
-r base.in

ruff                      # линтер и форматтер
bandit                    # статический поиск проблем безопасности
                          # ⚠️ pymorphy3 и pymorphy3-dicts-ru ПЕРЕЕХАЛИ В
                          # base.in 13.09.2026 — они нужны не только тесту
                          # контрольного набора словоформ
                          # (problems/tests/test_econ_terms.py), но и бою:
                          # лексическая нога умного поиска зовёт их на
                          # каждом запросе. Здесь их больше нет, но CI
                          # по-прежнему их ставит — dev.in включает base.in
                          # строкой `-r base.in` выше. В local.in им тоже не
                          # место: там ML-стек, а это чистый Python.
pip-audit                 # уязвимости в зависимостях по базе CVE
pip-tools                 # компиляция .in -> .txt с точными версиями
tblib                     # ⚠️ БЕЗ НЕГО ПЕРВОЕ ЖЕ ПАДЕНИЕ ОБРЫВАЕТ ВЕСЬ
                          # ПАРАЛЛЕЛЬНЫЙ ПРОГОН. При `--parallel` тесты идут
                          # в отдельных процессах, и упавшее исключение едет
                          # к раннеру через pickle вместе с traceback, а он
                          # не пиклится. Замерено 2026-08-21 на стенде из
                          # двух классов: без tblib нет ни строки `Ran N
                          # tests`, ни `FAILED (...)` — прогон разваливается,
                          # и остальные тесты не досчитываются. С tblib то же
                          # падение даёт обычный разбор и полную сводку.
                          # ⚠️ Стенду нужно НЕ МЕНЬШЕ ДВУХ классов: Django не
                          # поднимает воркеров больше, чем классов, и на одном
                          # классе --parallel схлопывается в один процесс —
                          # первая версия проверки на этом и обманулась.

rapidfuzz                 # ⚠️ ЗДЕСЬ, А НЕ В base.in: команда
                          # find_olympiad_text_duplicates — офлайновый разбор
                          # банка, на прод не едет (то же правило, что для
                          # ML-стека, ADR 0002). Но и не local.in: на ней
                          # стоят тесты problems/tests/test_find_olympiad_text_duplicates.py,
                          # а CI ставит dev.txt — лежи пакет в local.in, тесты
                          # молча падали бы в CI. Ровно ловушка pymorphy3 выше.
                          # Импорт в команде ленивый, внутри функции — как у
                          # sentence_transformers в build_embeddings.
