# База данных
db.sqlite3
*.sqlite3
backups/
# ⚠️ Резервные копии базы. Шаблоны выше их НЕ ловят: файл вида
# `db.sqlite3.backup-2026-08-21` не заканчивается на «.sqlite3» и не равен
# «db.sqlite3» — точное имя и «*.sqlite3» мимо. В ночь 21.08 такой файл на
# 441,6 МБ уехал в 15 коммитов через `git add`, и пуш отбил сам GitHub
# (лимит 100 МБ, GH001). Ниже закрыт весь класс, а не один файл.
db.sqlite3*
*.backup-*
*.backup

# Исходные материалы для импорта (большие файлы, не нужны на сервере)
materials/

# Загружаемые пользователями файлы
media/

# ИСКЛЮЧЕНИЕ: логотипы олимпиад и вузов. Это не загрузки пользователей, а
# материал проекта: знаки скачаны с официальных сайтов и нужны на сервере
# так же, как шаблоны. Без них поле logo в базе указывало бы на файл,
# которого на сервере нет, и вместо знака вышла бы битая картинка.
# Цепочка из четырёх строк нужна потому, что git не заглядывает внутрь
# исключённой папки: приходится открывать её по одному уровню.
!media/
media/*
!media/olympiads/
media/olympiads/*
!media/olympiads/logos/

