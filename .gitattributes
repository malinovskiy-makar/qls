# ⚠️ ЭТОТ ФАЙЛ ЗАВЕДЁН РАДИ ОДНОЙ СТРОКИ — ТОЙ, ЧТО ПРО *.sh.
#
# Проект живёт на Windows, и git по умолчанию отдаёт файлы в рабочую копию
# с CRLF. Для скрипта, который исполняется ВНУТРИ КОНТЕЙНЕРА Linux, это
# смертельно: первая строка `#!/bin/sh` превращается в `#!/bin/sh\r`, ядро
# ищет интерпретатор с именем «sh\r» и не находит. Контейнер падает с
# сообщением вида «no such file or directory» — указывающим на сам скрипт,
# который при этом на месте и прекрасно читается глазами. Разбор такого
# отказа стоит вечера.
#
# Замечено 2026-08-21 при сборке образа: git предупредил, что при следующем
# обращении заменит LF на CRLF. Сборка тогда прошла только потому, что в
# рабочей копии ещё лежал LF. На чистом клоне (в том числе на сервере)
# сломалось бы.
*.sh text eol=lf

# Файлы, которые тоже читает Linux внутри контейнера.
Dockerfile text eol=lf
.dockerignore text eol=lf
deploy/**/*.yml text eol=lf
deploy/**/*.conf text eol=lf

# ⚠️ Юниты systemd читает Linux — по той же причине, что и *.sh выше.
# systemd на строку с CRLF не ругается внятно: он берёт `` частью ЗНАЧЕНИЯ,
# и `ExecStart=/…/dev_autodeploy.sh` не находит файл. Отказ выглядит как
# «нет такого файла» при файле на месте.
deploy/systemd/* text eol=lf
